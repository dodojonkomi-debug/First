APP_NAME="МТМУ - Система қабули хонандагон"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Dushanbe
APP_URL=http://localhost:8000
APP_LOCALE=tg
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=debug

# ===== БАЗАИ МАЪЛУМОТ (MySQL) =====
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=school_admission
DB_USERNAME=root
DB_PASSWORD=

# ===== СЕССИЯ / КЭШ / НАВБАТ =====
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_DOMAIN=localhost
CACHE_STORE=database
QUEUE_CONNECTION=database

# ===== SANCTUM / CORS =====
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ===== ФАЙЛҲО =====
# 'public' барои локалӣ; барои продакшен метавонед 's3' истифода баред
FILESYSTEM_DISK=public

# ===== AWS S3 (ихтиёрӣ — барои продакшен) =====
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
